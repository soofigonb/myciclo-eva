USUARIOS_DB_URL=jdbc:postgresql://localhost:5432/eva_usuarios
USUARIOS_DB_USER=
USUARIOS_DB_PASSWORD=
USUARIOS_DB_DRIVER=org.postgresql.Driver
USUARIOS_DB_SCHEMA=db_usuarios

# Configuración JWT compartida con seguimiento-service (usar al menos 32 caracteres en JWT_SECRET)
JWT_SECRET=
JWT_ISSUER=myciclo-eva-usuarios
JWT_AUDIENCE=myciclo-eva-api
JWT_EXPIRATION_SECONDS=86400
